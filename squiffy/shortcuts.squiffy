{{!--
    Shortcuts, for testing. They're marked @test, so they're left out of the published story, and
    the Start at menu of the story served by "npm run serve" lists them first (or add
    ?start=The end, say, to its address). From the command line, use --start.

    Each one starts where a single click plays the moment, on a Victoria line train that has just
    left Stockwell, with nothing else having happened.
--}}

[[Getting on at Balham]]:
@test
{{!-- The page goes up, two clicks in --}}
@set to = "Balham"
{{goto "shortcut"}}

[[Leaving my usual train]]:
@test
{{!-- The page goes left --}}
@set to = "escape at Stockwell"
{{goto "shortcut"}}

[[Meeting Heather]]:
@test
{{!-- Her name, everywhere --}}
@set to = "Heather"
{{goto "shortcut"}}

[[Blacking out]]:
@test
{{!-- Speckles, and black --}}
@set to = "pale"
{{goto "shortcut"}}

[[HEATHER goes by]]:
@test
{{!-- Her name goes by like a train --}}
@set to = "HEATHER"
{{goto "shortcut"}}

[[The way home]]:
@test
{{!-- Everything goes by like a train --}}
@set to = "empty hope"
{{goto "shortcut"}}

[[The end]]:
@test
{{!-- The last photograph --}}
@set to = "one small thing"
{{goto "shortcut"}}

[[shortcut]]:
@test
@clear
@set escaped = "Stockwell"
@set station = "Stockwell"
@set line = "victoria"
@set direction = -1
@set t = 40
@set noticed = []
@set platforms = []
@set been = []
@set told = []
{{board}}{{goto to}}
